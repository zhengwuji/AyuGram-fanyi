<Window x:Class="AyuTranslate.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AyuTranslate 设置"
        Width="880" Height="720"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1F22"
        Foreground="#FFE6E6E6"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE6E6E6"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFB8B8B8"/>
            <Setter Property="Padding" Value="0,0,0,2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2B2D31"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF3F4147"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#FF2B2D31"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF3F4147"/>
            <Setter Property="Padding" Value="6,5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF2B2D31"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE6E6E6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF3A3D43"/>
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
            <Setter Property="BorderBrush" Value="#FF4A4D55"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#FFB8B8B8"/>
            <Setter Property="Background" Value="#FF232428"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#FF9CDCFE"/>
            <Setter Property="BorderBrush" Value="#FF3F4147"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8A8D94"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#FF232428" Padding="12,10" BorderBrush="#FF3F4147" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="测试翻译接口" Click="OnTestTranslator" Background="#FF2D4A7A"/>
                    <Button Content="测试识别(OCR)" Click="OnTestOcr" Background="#FF2D4A7A"/>
                    <Button Content="保存" Click="OnSave" Background="#FF2F6B3A" FontWeight="Bold"/>
                    <Button Content="取消" Click="OnCancel"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#FF9CDCFE" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Background="#FF1E1F22" BorderBrush="#FF3F4147" Margin="8">
            <!-- ============ 原生翻译接管 ============ -->
            <TabItem Header="原生翻译接管">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <Border Background="#FF23324A" CornerRadius="4" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="这是什么？" FontWeight="Bold" Foreground="#FF9CDCFE" Margin="0,0,0,6"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#FFD6E4F0" LineHeight="19"
                                           xml:space="preserve">AyuGram 自带翻译功能，译文直接替换消息原文（原生渲染，可点「显示原文」切换）。但它内置的翻译后端是写死的，不支持自定义接口。

本功能把 AyuGram 内置「Google 翻译」的接口地址改写成本地代理，再由代理转发到你自己的 AI。于是：
  · 界面完全原生，效果和 AyuGram 自带翻译一模一样
  · 翻译内容由你的 AI 生成
  · 不需要截图、不需要 OCR、不需要覆盖层</TextBlock>
                            </StackPanel>
                        </Border>

                        <GroupBox Header="第 1 步 · 改写 AyuGram 接口地址">
                            <StackPanel>
                                <TextBlock x:Name="PatchStatusText" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Foreground="#FFB8B8B8" Text="检测中…"/>
                                <TextBlock Text="目标文件"/>
                                <TextBox x:Name="PatchExeBox"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="打补丁" Click="OnApplyPatch" Background="#FF2D4A7A"/>
                                    <Button Content="还原为原版" Click="OnRestorePatch" Background="#FF5A3A3A"/>
                                    <Button Content="刷新状态" Click="OnRefreshPatchStatus"/>
                                    <Button Content="打开所在目录" Click="OnOpenTargetDir"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="打补丁前必须先完全退出 AyuGram（含托盘图标）。程序会自动备份为 AyuGram.exe.ayutranslate.bak，随时可还原。"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="第 2 步 · 启动本地代理">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="监听端口"/>
                                        <TextBox x:Name="ProxyPortBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="当前状态"/>
                                        <TextBlock x:Name="ProxyStatusText" Text="未运行" Margin="0,5,0,10"
                                                   Foreground="#FF9CDCFE" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="ProxyAutoStartBox" Content="打开本程序时自动启动代理"/>
                                <CheckBox x:Name="ProxyFallbackBox" Content="AI 翻译失效时自动回退到免费谷歌翻译（推荐）"
                                          Margin="0,3,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="启动代理" Click="OnStartProxy" Background="#FF2F6B3A"/>
                                    <Button Content="停止代理" Click="OnStopProxy"/>
                                    <Button Content="测试代理" Click="OnTestProxy"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="代理只监听 127.0.0.1，不对外暴露。需要保持本程序运行。"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="第 3 步 · 在 AyuGram 里选择 Google 翻译">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" LineHeight="19" Foreground="#FFD6E4F0"
                                           Text="打开 AyuGram → 设置 → AyuGram 选项 → 翻译服务，把翻译提供方选为「Google」。"/>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                           Text="选 Google 是因为它的接口格式已知、且是明文 HTTP 请求，可以安全改写。另外几个走 Telegram 服务器或加密协议，无法接管。"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="翻译日志（最新的在最上面）">
                            <StackPanel>
                                <TextBox x:Name="ProxyLogBox" AcceptsReturn="True" TextWrapping="NoWrap"
                                         Height="150" IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="刷新" Click="OnRefreshProxyLog"/>
                                    <Button Content="清空" Click="OnClearProxyLog"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 翻译服务 ============ -->
            <TabItem Header="翻译服务">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <TextBlock Text="接口类型"/>
                        <ComboBox x:Name="ProviderBox" SelectionChanged="OnProviderChanged"/>

                        <TextBlock Text="API 地址（自定义 AI 地址）"/>
                        <TextBox x:Name="BaseUrlBox"/>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="OpenAI 兼容接口填 base url，例如：&#10;  https://api.deepseek.com/v1&#10;  https://api.openai.com/v1&#10;  http://127.0.0.1:11434/v1   (Ollama)&#10;  http://127.0.0.1:1234/v1     (LM Studio)&#10;程序会自动补上 /chat/completions。也可以在这里直接填完整地址。"/>

                        <TextBlock Text="完整接口地址（留空则按上面的 API 地址自动拼）"/>
                        <TextBox x:Name="EndpointBox"/>

                        <TextBlock Text="API 密钥"/>
                        <PasswordBox x:Name="ApiKeyBox"/>
                        <TextBlock Style="{StaticResource Hint}" Text="本地 Ollama / one-api 无需密钥时留空即可。密钥保存在 %APPDATA%\AyuTranslate\config.json。"/>

                        <TextBlock Text="模型名称"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="ModelBox" IsEditable="True" Margin="0,0,8,10"/>
                            <Button Grid.Column="1" Content="获取模型列表" Click="OnFetchModels" Margin="0,0,8,10"/>
                            <Button Grid.Column="2" Content="测试" Click="OnTestTranslator" Margin="0,0,0,10"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="例如 deepseek-chat / gpt-4o-mini / qwen2.5:7b / glm-4-flash。点「获取模型列表」会从上面的 API 地址拉取真实可用的模型名（需服务商支持 /models）。"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="目标语言"/>
                                <ComboBox x:Name="TargetLangBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="源语言"/>
                                <ComboBox x:Name="SourceLangBox"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="系统提示词（{target} 会被替换成目标语言名）"/>
                        <TextBox x:Name="PromptBox" AcceptsReturn="True" TextWrapping="Wrap" Height="110"
                                 VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="额外请求头（每行一个，Key: Value）"/>
                        <TextBox x:Name="HeadersBox" AcceptsReturn="True" TextWrapping="Wrap" Height="60"
                                 VerticalScrollBarVisibility="Auto"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="超时（秒）"/>
                                <TextBox x:Name="TimeoutBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="重试次数"/>
                                <TextBox x:Name="RetriesBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="温度"/>
                                <TextBox x:Name="TemperatureBox"/>
                            </StackPanel>
                        </Grid>

                        <GroupBox Header="自定义 HTTP 接口（仅当接口类型选“自定义 HTTP”时生效）">
                            <StackPanel>
                                <TextBlock Text="请求体模板"/>
                                <TextBox x:Name="RequestTemplateBox" AcceptsReturn="True" TextWrapping="Wrap" Height="70"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="可用占位符：{text} 原文(JSON 转义) / {text_raw} 原文(不转义) / {target} / {source} / {target_name}。&#10;把 {text} 写进 URL 则会用 GET 请求。"/>
                                <TextBlock Text="响应取值路径"/>
                                <TextBox x:Name="ResponsePathBox"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="用点号表示层级，例如：&#10;  data.translation&#10;  choices.0.message.content&#10;  translations.0.text"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 识别与区域 ============ -->
            <TabItem Header="识别与区域">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <GroupBox Header="聊天区域（相对 AyuGram 窗口客户区，单位像素）">
                            <StackPanel>
                                <CheckBox x:Name="RegionAutoBox" Content="自动推断聊天区域（推荐）" Checked="OnRegionAutoChanged" Unchecked="OnRegionAutoChanged"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X"/>
                                        <TextBox x:Name="RegionXBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y"/>
                                        <TextBox x:Name="RegionYBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="宽"/>
                                        <TextBox x:Name="RegionWBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="高"/>
                                        <TextBox x:Name="RegionHBox"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="IncludeSidebarBox" Content="把左侧会话列表也纳入翻译范围"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="默认只翻译右侧聊天内容，避免把会话列表、时间戳一起翻掉。&#10;点“测试识别(OCR)”可以查看当前区域抓到的文本块数量。"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="OCR 识别">
                            <StackPanel>
                                <TextBlock Text="识别语言（按顺序尝试，逗号分隔）"/>
                                <TextBox x:Name="OcrLangBox"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="使用 Windows 自带 OCR。可用语言取决于系统安装情况，例如：&#10;  zh-Hans-CN, en-US, ja-JP, ko-KR, ru-RU&#10;若某语言不可用，程序会自动跳过。系统未安装对应识别包时，请到「设置 → 时间和语言 → 语言和区域 → 语言选项」里安装“光学字符识别”。"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="放大倍数"/>
                                        <TextBox x:Name="OcrScaleBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="行合并间距"/>
                                        <TextBox x:Name="MergeGapBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="最小行高"/>
                                        <TextBox x:Name="MinLineHeightBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="最短文本"/>
                                        <TextBox x:Name="MinTextLenBox"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="OcrAvailableText" Style="{StaticResource Hint}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="翻译过滤">
                            <StackPanel>
                                <CheckBox x:Name="SkipTargetLangBox" Content="跳过已经是目标语言的消息"/>
                                <CheckBox x:Name="CacheEnabledBox" Content="启用翻译缓存（相同文本不重复请求）"/>
                                <TextBlock Text="缓存条目上限"/>
                                <TextBox x:Name="CacheSizeBox"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 外观 ============ -->
            <TabItem Header="覆盖层外观">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <GroupBox Header="颜色（#AARRGGBB，AA 为透明度）">
                            <StackPanel>
                                <TextBlock Text="背景色"/>
                                <TextBox x:Name="OverlayBgBox"/>
                                <TextBlock Text="译文字色"/>
                                <TextBox x:Name="OverlayFgBox"/>
                                <TextBlock Text="原文色"/>
                                <TextBox x:Name="OverlayOrigFgBox"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="示例：#D9000000 约 85% 不透明黑底；#CCFFFFFF 约 80% 不透明白字。"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="排版">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="字号"/>
                                        <TextBox x:Name="FontSizeBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="上下留白"/>
                                        <TextBox x:Name="PadYBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="外扩像素"/>
                                        <TextBox x:Name="BleedBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="6">
                                        <TextBlock Text="不透明度"/>
                                        <TextBox x:Name="OpacityBox"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="字体"/>
                                <TextBox x:Name="FontFamilyBox"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="译文最多显示行数"/>
                                        <TextBox x:Name="MaxLinesBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="最多覆盖条目数"/>
                                        <TextBox x:Name="MaxItemsBox"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="ShowOriginalBox" Content="在译文下保留一行灰色原文"/>
                                <CheckBox x:Name="ClickThroughBox" Content="鼠标穿透（推荐，点击会直接落到 AyuGram 上）"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="“外扩像素”用来把原文盖住：OCR 的行框往往比实际文字紧，适当加大可以避免漏出原文边缘。"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="预览">
                            <StackPanel>
                                <Border Height="150" Background="#FF2B2D31" CornerRadius="4" ClipToBounds="True">
                                    <Canvas x:Name="PreviewCanvas" ClipToBounds="True"/>
                                </Border>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                           Text="预览按当前颜色 / 字号 / 内边距设置绘制，用来估算实际观感。"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 运行与输入 ============ -->
            <TabItem Header="运行与输入">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
                    <StackPanel>
                        <GroupBox Header="运行">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="抓取间隔（毫秒）"/>
                                        <TextBox x:Name="PollIntervalBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="请求最小间隔（毫秒）"/>
                                        <TextBox x:Name="MinRequestIntervalBox"/>
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="OnlyFocusedBox" Content="仅在 AyuGram 处于前台时自动翻译"/>
                                <CheckBox x:Name="HideWhenUnfocusedBox" Content="AyuGram 切到后台时自动收起覆盖层（推荐）"/>
                                <CheckBox x:Name="StartVisibleBox" Content="启动后立即显示覆盖层"/>
                                <CheckBox x:Name="DebugLogBox" Content="记录详细调试日志"/>
                                <TextBlock Text="AyuGram.exe 路径"/>
                                <TextBox x:Name="TargetExeBox"/>
                                <TextBlock Style="{StaticResource Hint}" Text="换成 AyuGram 的可执行文件路径。指向 Telegram Desktop 也可以，只要是 Qt 窗口就能工作。"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="全局快捷键">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="立即翻译一次"/>
                                        <TextBox x:Name="HotkeyTranslateBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="显示/隐藏覆盖层"/>
                                        <TextBox x:Name="HotkeyToggleOverlayBox"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="自动翻译 开/关"/>
                                        <TextBox x:Name="HotkeyToggleAutoBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="打开设置"/>
                                        <TextBox x:Name="HotkeySettingsBox"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="格式：Ctrl+Alt+T / Ctrl+Shift+F9 / Alt+Q。修改后需要重启程序或点保存热重载。"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="写回输入框">
                            <StackPanel>
                                <TextBlock Text="写入方式"/>
                                <ComboBox x:Name="InputMethodBox"/>
                                <TextBlock Text="写入后"/>
                                <ComboBox x:Name="InputSendModeBox"/>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="“仅填入”最安全，写入后你自己检查再回车。“填入并回车”会直接发送，请谨慎使用。"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="其他">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="打开配置目录" Click="OnOpenConfigDir"/>
                                <Button Content="打开日志目录" Click="OnOpenLogDir"/>
                                <Button Content="打开配置文件夹中的 config.json" Click="OnOpenConfigFile"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
