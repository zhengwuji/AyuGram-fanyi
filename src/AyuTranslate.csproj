<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- WPF 提供窗口/绘制；WindowsForms 用来拿 System.Drawing.Common 与托盘图标 -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AyuTranslate</AssemblyName>
    <RootNamespace>AyuTranslate</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>AyuTranslate</Product>
    <Description>AyuGram / Telegram Desktop 实时翻译覆盖层</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFAC010: WinForms SDK 建议不要用 manifest 声明 DPI。
         本项目以 WPF 为主，PerMonitorV2 still 由 app.manifest 声明最可靠，因此屏蔽该提示。 -->
    <NoWarn>CA1416;CS1998;WFO5001;WFAC010</NoWarn>
    <DebugType>none</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI 加密 API 密钥（.NET 8 里 ProtectedData 在这个包里） -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="_probe\**" />
    <Compile Remove="tools\**" />
    <None Remove="_probe\**" />
    <None Remove="tools\**" />
    <Page Remove="_probe\**" />
  </ItemGroup>

</Project>
